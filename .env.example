# Copy to .env and fill in. .env is gitignored; never commit it.

# ntfy.sh topic for push notifications. Anyone who knows the topic name can
# read and post to it, so use a long random string.
NTFY_TOPIC=

# Stations, spelled exactly as SEPTA's NextToArrive API expects.
HOME_STATION=Glenside
WORK_STATION=Suburban Station
TRANSFER_STATION=Jefferson Station
# Tried in order when no connection works at TRANSFER_STATION (comma separated).
TRANSFER_FALLBACK_STATIONS=Suburban Station,30th Street Station

# Minutes to walk to each station you depart from: "Station:minutes", comma separated.
WALK_TIMES=Glenside:5,Suburban Station:5,Jefferson Station:3

# The train home you usually aim for, and when the afternoon push goes out.
AFTERNOON_TARGET_DEPARTURE=5:00PM
NOTIFY_TIME=4:00PM

# Lines whose SEPTA service alerts matter to you (comma separated).
RELEVANT_LINES=Lansdale/Doylestown

# Where to get the forecast. A town or neighborhood centroid is plenty.
WEATHER_LAT=39.9526
WEATHER_LON=-75.1652
